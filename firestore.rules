rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents — only accessible by the owning user
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Gamification subcollection — user-scoped access
      match /gamification/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sessions subcollection — user-scoped access
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Turns within a session — user-scoped access
        match /turns/{turnNumber} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
